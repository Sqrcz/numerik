{
  "name": "slashlab/numerik",
  "description": "Modern PHP 8.3+ library for validating and parsing Polish identification numbers (PESEL, NIP, REGON, KRS, NRB, VAT-EU, IBAN, ID Card, Passport).",
  "type": "library",
  "license": "MIT",
  "homepage": "https://numerik.slashlab.pl",
  "keywords": [
    "iban",
    "id-card",
    "krs",
    "nip",
    "nrb",
    "numerik",
    "passport",
    "pesel",
    "poland",
    "polish",
    "regon",
    "validation",
    "validator",
    "vat-eu"
  ],
  "authors": [
    {
      "name": "Sqrcz",
      "role": "Developer",
      "homepage": "https://github.com/sqrcz"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "infection/infection": "^0.29",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "SlashLab\\Numerik\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SlashLab\\Numerik\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "test:cover": "phpunit --configuration phpunit.xml --coverage-html coverage/html --coverage-clover coverage/clover.xml",
    "stan": "phpstan analyse --memory-limit=512M",
    "cs-fix": "php-cs-fixer fix",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "mutation": "infection",
    "check": [
      "@cs-check",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
